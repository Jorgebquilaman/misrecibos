{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "PortalIUPA.Worker.Reloj": "Information"
    }
  },
  "Reloj": {
    // Dispositivo ZKTeco 628C
    "Ip": "192.168.1.204",
    "Puerto": 4370,
    "CommKey": 0,
    "NombreDispositivo": "SALA-3",
    // Cadena hacia la base SQL Server existente del software del proveedor.
    // Para este SQL Server 2014 viejo lanzar el worker con la env var OPENSSL_CONF
    // apuntando a la config TLS legacy (igual que el API del portal).
    "ConnectionStringSql": "",
    "IntervaloSegundos": 300,
    "BackoffMaximoSegundos": 1800,
    "BorrarLogTrasLeer": false,
    "DeshabilitarDuranteLectura": true,
    // Esquema del software del proveedor: adaptar nombres si cambian sin tocar el código.
    "Esquema": {
      "TablaMarcas": "checkinout",
      "TablaUsuarios": "userinfo",
      "ColUserId": "USERID",
      "ColCheckTime": "CHECKTIME",
      "ColCheckType": "CHECKTYPE",
      "ColBadgeNumber": "BADGENUMBER",
      "TablaCheckpoint": "ZkSync_Control_Checkpoint"
    }
  }
}
